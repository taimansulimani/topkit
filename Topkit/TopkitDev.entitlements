<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Topkit Dev (Debug and Release) runs unsandboxed but with the hardened
	     runtime, which blocks the microphone unless this is granted. Without
	     it Subtitles and Audio silently record nothing. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
