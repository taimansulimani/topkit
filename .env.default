# Committed template — placeholders only. DO NOT put real keys, IDs, emails, or
# phone numbers here. Copy this to a local, gitignored `.env` and fill in real
# values there (fastlane auto-loads `.env` and it takes precedence over this file).

# App Store Connect API key auth
# Option A: provide a key file path
ASC_KEY_ID=YOUR_KEY_ID
ASC_ISSUER_ID=YOUR_ISSUER_ID
ASC_KEY_FILEPATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8

# Option B: provide base64 key content instead of ASC_KEY_FILEPATH
# ASC_KEY_CONTENT_BASE64=BASE64_ENCODED_P8_CONTENT

# Exact profile name shown in Developer portal / Xcode
APPSTORE_PROVISIONING_PROFILE_NAME=Topkit

# App Review contact details
APP_REVIEW_CONTACT_EMAIL=hello@example.com
APP_REVIEW_CONTACT_FIRST_NAME=First
APP_REVIEW_CONTACT_LAST_NAME=Last
APP_REVIEW_CONTACT_PHONE=+1-555-555-5555
